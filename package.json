{
  "name": "@chendaleiq/dsh-chrome",
  "version": "0.1.1",
  "type": "module",
  "description": "Control local Chrome from DSH: status, tabs, snapshot, navigate, screenshot, evaluate.",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js",
    "extension/**/*",
    "scripts/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/DETAIL.md",
    "docs/TESTING.md",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "icon": "./icon.svg",
  "author": "chendaleiQ",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "chrome",
    "cdp",
    "browser",
    "local-first",
    "macos"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "verify": "node scripts/verify.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chendaleiQ/dsh-chrome.git"
  },
  "homepage": "https://github.com/chendaleiQ/dsh-chrome#readme",
  "bugs": {
    "url": "https://github.com/chendaleiQ/dsh-chrome/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
